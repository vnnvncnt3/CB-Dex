@page "/"

<PageTitle>Cardbooth</PageTitle>

<main class="mx-auto max-w-3xl p-6">
    <h1 class="text-4xl">Cardbooth</h1>
    <p class="mt-1 text-neutral-500">be your own card</p>

    <div class="card-frame mt-6 p-4">
        <div class="grid grid-cols-2 gap-2 text-sm font-semibold sm:grid-cols-5">
            <div class="rounded bg-type-colorless p-3">Colorless</div>
            <div class="rounded bg-type-grass p-3">Grass</div>
            <div class="rounded bg-type-fire p-3">Fire</div>
            <div class="rounded bg-type-water p-3">Water</div>
            <div class="rounded bg-type-lightning p-3">Lightning</div>
            <div class="rounded bg-type-psychic p-3 text-white">Psychic</div>
            <div class="rounded bg-type-fighting p-3">Fighting</div>
            <div class="rounded bg-type-darkness p-3 text-white">Darkness</div>
            <div class="rounded bg-type-metal p-3">Metal</div>
            <div class="rounded bg-type-fairy p-3">Fairy</div>
        </div>
    </div>
</main>