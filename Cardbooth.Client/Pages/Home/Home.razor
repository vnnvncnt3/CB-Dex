@page "/"

<PageTitle>Cardbooth</PageTitle>

<main class="mx-auto max-w-3xl p-6">
    <h1 class="text-4xl">Cardbooth</h1>
    <p class="mt-1 text-neutral-500">be your own card</p>

    <section id="calendar" class="mt-8">
        <h2 class="mb-3 text-2xl">Pick a date</h2>
        <CalendarGrid @bind-SelectedDate="_selectedDate" />
        <p class="mt-3 text-sm text-neutral-600">
            @(_selectedDate is { } date ? $"Selected: {date:MMMM d, yyyy}" : "No date selected yet.")
        </p>
    </section>
</main>