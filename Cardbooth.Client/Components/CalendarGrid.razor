@using System.Globalization
<div class="card-frame p-4">
    <div class="mb-4 flex items-center justify-between">
        <button type="button" @onclick="PreviousMonthAsync" disabled="@(!CanGoPrevious || _loading)"
                aria-label="Previous month"
                class="rounded-lg px-3 py-2 text-lg font-bold hover:bg-neutral-100 disabled:text-neutral-300">‹</button>

        <h2 class="text-xl">@_visibleMonth.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</h2>

        <button type="button" @onclick="NextMonthAsync" disabled="@_loading"
                aria-label="Next month"
                class="rounded-lg px-3 py-2 text-lg font-bold hover:bg-neutral-100 disabled:text-neutral-300">›</button>
    </div>

    <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-neutral-500">
        @foreach (var name in DayNames)
        {
            <div>@name</div>
        }
    </div>

    <div class="mt-1 grid grid-cols-7 gap-1">
        @for (var i = 0; i < LeadingBlanks; i++)
        {
            <div></div>
        }

        @for (var day = 1; day <= DaysInMonth; day++)
        {
            var date = new DateOnly(_visibleMonth.Year, _visibleMonth.Month, day);
            var state = GetState(date);

            <button type="button"
                    @onclick="() => SelectAsync(date)"
                    disabled="@(state is DayState.Unavailable or DayState.Past)"
                    aria-label="@Label(date, state)"
                    class="aspect-square rounded-lg text-sm transition-colors @DayClass(state)">
                @day
            </button>
        }
    </div>

    <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-neutral-600">
        <span><span class="inline-block h-3 w-3 rounded border border-neutral-400 bg-white align-middle"></span> Open</span>
        <span><span class="inline-block h-3 w-3 rounded bg-accent align-middle"></span> Selected</span>
        <span><span class="line-through">12</span> Unavailable</span>
    </div>
</div>